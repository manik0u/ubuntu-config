## Lister ici les packages locaux deb à gérer selon le schéma suivant :
#add:URL_localdebpackagename - l'URL doit être le lien direct vers le fichier *.deb
#del:URL_localdebpackagename - l'URL doit être le lien direct vers le fichier *.deb

# ProtonMail
del:https://proton.me/download/mail/linux/ProtonMail-desktop-beta.deb
add:https://proton.me/download/mail/linux/ProtonMail-desktop-beta.deb

# Mots de passe
add:https://github.com/bitwarden/clients/releases/download/desktop-v2025.2.1/Bitwarden-2025.2.1-amd64.deb

